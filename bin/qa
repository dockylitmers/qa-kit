#!/usr/bin/env python3
"""qa — command-line companion for qa-kit.

Python standard library only. The LLM writes content; this script does
format checks, ledger writes, deterministic stats and eval plumbing.

  qa doctor [--target <repo>]   installation check (exit 1 on any failure); --target adds
                                a target-repo toolchain check (warnings only)
  qa init <project>             create projects/<project>/ and evals/<project>/
  qa check                      validate patterns, eval cases, run ledgers, leaks
  qa pattern list|show|new|index
  qa finding add|review|judge|applied|scope|list
  qa calibration add|list       severity calibration (finder -> refutations -> confirmed)
  qa proposal show|decide|apply item-level knowledge changes, applied deterministically
  qa issue search               existing issues and recorded won't-fix decisions
  qa misses collect             bug issues since a date that no kit run reported
  qa eval list|run|report|audit <case>
  qa coverage init|set|check    entry points x check axes (+ invariants); blank cells fail the report
  qa seed list|apply|run        plant known defects in throwaway copies; measure the miss rate
  qa rederive                   blind re-run of a finished run (results and derived patterns hidden)
  qa sync                       pull/commit/push the knowledge repo
"""

