PATTERN_STATUS = {"candidate", "active", "probation", "needs_revalidation", "retired"}
PATTERN_TIER = {"global", "project"}
FAILURE_CLASS = {"boundary", "sad_path", "error_propagation", "concurrency"}
SEVERITY = {"critical", "high", "medium", "low"}
VERDICTS = {"accepted", "false_positive", "wont_fix", "duplicate"}
REVIEW_VERDICTS = {"refuted", "stands", "downgraded", "uncertain"}
EVIDENCE_LEVELS = {"L0", "L1", "L2", "L3", "L4", "L5", "LD"}  # LD: reproduced on a device (device-qa)
SEVERITY_RANK = {"low": 0, "medium": 1, "high": 2, "critical": 3}
PATTERN_REQUIRED = [
    "id", "status", "tier", "failure_class", "title", "scope", "probe", "oracle",
    "evidence_required", "false_positive_traps", "severity_prior", "stats",
    "validity", "provenance", "eval_links",
]
